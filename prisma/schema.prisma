generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Language {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  flagEmoji String
  isActive  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  levels Level[]
}

model Level {
  id         String @id @default(cuid())
  languageId String
  name       String
  order      Int    @default(0)

  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  modules  Module[]

  @@index([languageId])
}

model Module {
  id      String  @id @default(cuid())
  levelId String
  title   String
  icon    String?
  order   Int     @default(0)

  level   Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([levelId])
}

enum LessonType {
  STANDARD
  REVIEW
}

model Lesson {
  id       String     @id @default(cuid())
  moduleId String
  title    String
  type     LessonType @default(STANDARD)
  order    Int        @default(0)

  module     Module                @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions  Question[]
  progress   UserLessonProgress[]
  ballEvents BallEvent[]

  @@index([moduleId])
}

enum QuestionType {
  MULTIPLE_CHOICE
  MATCHING
  SENTENCE_BUILD
  PICTURE_MATCH
}

model Question {
  id       String       @id @default(cuid())
  lessonId String
  type     QuestionType
  prompt   String
  payload  Json
  order    Int          @default(0)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model User {
  id                String    @id @default(cuid())
  telegramId        String    @unique
  username          String?
  firstName         String?
  photoUrl          String?
  channelSubscribed Boolean   @default(false)
  channelCheckedAt  DateTime?
  totalBall         Int       @default(0)
  currentStreak     Int       @default(0)
  longestStreak     Int       @default(0)
  lastActiveDate    DateTime?
  createdAt         DateTime  @default(now())

  progress   UserLessonProgress[]
  ballEvents BallEvent[]
}

enum LessonProgressStatus {
  LOCKED
  UNLOCKED
  COMPLETED
}

model UserLessonProgress {
  id          String                @id @default(cuid())
  userId      String
  lessonId    String
  status      LessonProgressStatus  @default(LOCKED)
  completedAt DateTime?
  ballEarned  Int                   @default(0)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model BallEvent {
  id         String   @id @default(cuid())
  userId     String
  amount     Int
  source     String
  lessonId   String?
  languageId String?
  createdAt  DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([languageId, createdAt])
}
